{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.instantclips/instantclips",
  "title": "InstantClips",
  "description": "Create branded vertical video ads from ecommerce product URLs or product photos.",
  "version": "1.5.0",
  "websiteUrl": "https://instantclips.ai/automate/",
  "repository": {
    "url": "https://github.com/InstantStudioAI/instantclips-mcp",
    "source": "github",
    "id": "1349434456"
  },
  "icons": [
    {
      "src": "https://instantclips.ai/assets/instantclips-icon-512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://app.instantclips.ai/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Optional: sign in through OAuth when the client offers it (the server announces the flow on its 401); otherwise a Bearer token from app.instantclips.ai/settings#ai-access.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "instantclips-mcp",
      "version": "1.5.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "INSTANTCLIPS_TOKEN",
          "description": "Bearer token from app.instantclips.ai/settings#ai-access",
          "format": "string",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
